# Copy to .env and adjust.
DATABASE_URL="postgresql://sso:sso@localhost:5432/sso"
# Public URL of this API. IdPs redirect back here, so it must match what you register in Okta/Entra.
APP_URL="http://localhost:4000"
# URL of the web app (used for redirects after SSO and for the Origin check).
WEB_URL="http://localhost:5173"
PORT=4000
# 32 random bytes, base64. Encrypts OIDC client secrets at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_KEY="REPLACE_ME"
# Mounts a fake OIDC + SAML identity provider at /mock-idp for local testing. Never enable in production.
MOCK_IDP=true
